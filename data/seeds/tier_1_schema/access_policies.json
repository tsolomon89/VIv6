    "slug": "policy-allow-read-with-capability",
    "name": "Allow Read with Capability",
    "summary": "Allows read operations if user has read:* or read:{type} capability",
    "account_id": "00000000-0000-0000-0000-000000000000",
    "data": {
      "Trigger Event": "pre_read",
      "Trigger Entity Type": "*",
      "Conditions": "[{\"field\": \"$context.capabilities\", \"op\": \"has\", \"value\": \"read:*\"}]",
      "Actions": "[{\"type\": \"allow\"}]",
      "Priority": 100,
      "Is Active": true
