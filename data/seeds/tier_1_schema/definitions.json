    "data": {
      "category": "system",
      "icon": "calculator",
      "is_system": true,
      "fieldGroups": [
        {
          "name": "Configuration",
          "fields": [
            { "name": "Target Entity Type", "type": "text", "required": true, "summary": "Entity type this derivation applies to" },
            { "name": "Field Name", "type": "text", "required": true, "summary": "Name of the computed field" },
            { "name": "Return Type", "type": "select", "options": ["text", "number", "boolean", "date", "currency"], "required": true }
          ]
        },
        {
          "name": "Expression",
          "fields": [
            { "name": "Expression", "type": "textarea", "required": true, "summary": "Calculation expression (e.g., amount * probability)" },
            { "name": "Dependencies", "type": "textarea", "summary": "JSON list of field paths this derivation reads" }
          ]
        }
      ]
    }
  },
  {
    "type": "object_def",
    "slug": "metric",
    "name": "Metric",
    "summary": "An aggregation/rollup rule.",
    "data": {
      "category": "system",
      "icon": "bar-chart",
      "is_system": true,
      "fieldGroups": [
        {
          "name": "Source",
          "fields": [
            { "name": "Source Entity Type", "type": "text", "required": true, "summary": "Entity type to aggregate from" },
            { "name": "Source Field", "type": "text", "required": true, "summary": "Field to aggregate" },
            { "name": "Aggregation", "type": "select", "options": ["sum", "count", "avg", "min", "max"], "required": true }
          ]
        },
        {
          "name": "Target",
          "fields": [
            { "name": "Target Entity Type", "type": "text", "required": true, "summary": "Entity type to store result on" },
            { "name": "Target Field", "type": "text", "required": true, "summary": "Field to store result" },
            { "name": "Relationship Path", "type": "text", "summary": "How source relates to target (e.g., belongs_to)" }
          ]
        },
        {
          "name": "Options",
          "fields": [
            { "name": "Filters", "type": "textarea", "summary": "JSON filter conditions on source records" },
            { "name": "Track Lineage", "type": "boolean", "summary": "Whether to store which records contributed" }
          ]
        }
      ]
    }
  },
  {
    "type": "object_def",
    "slug": "rule",
    "name": "Rule",
    "summary": "A trigger/automation pattern.",
    "data": {
      "category": "system",
      "icon": "zap",
      "is_system": true,
      "fieldGroups": [
        {
          "name": "Trigger",
          "fields": [
            { "name": "Trigger Event", "type": "select", "options": ["pre_create", "post_create", "pre_update", "post_update", "pre_delete", "post_delete", "scheduled"], "required": true },
            { "name": "Trigger Entity Type", "type": "text", "required": true, "summary": "Entity type that triggers this rule" },
            { "name": "Conditions", "type": "textarea", "summary": "JSON conditions that must be true: [{field, op, value}]" }
          ]
        },
        {
          "name": "Execution",
          "fields": [
            { "name": "Actions", "type": "textarea", "required": true, "summary": "JSON actions to execute: [{type, target, data}]" },
            { "name": "Priority", "type": "number", "summary": "Execution order (lower = earlier)" },
            { "name": "Is Active", "type": "boolean", "summary": "Whether this rule is enabled" }
          ]
        }
      ]
    }
  }
