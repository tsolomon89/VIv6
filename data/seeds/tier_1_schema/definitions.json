  {
    "type": "object_def",
    "slug": "activity",
    "name": "Activity",
    "summary": "An event capturing user/system actions with physics-based tracking.",
    "data": {
      "category": "crm",
      "icon": "activity",
      "fieldGroups": [
        {
          "name": "Activity Details",
          "fields": [
            { "name": "Verb", "type": "text", "required": true, "summary": "Action taken (opened, clicked, submitted, etc.)" },
            { "name": "Archetype", "type": "select", "options": ["data", "asset", "engagement", "admin"], "summary": "Category of activity" },
            { "name": "Status", "type": "select", "options": ["pending", "in_progress", "completed", "won", "lost"], "summary": "Current status of the activity" },
            { "name": "Qualifiers Met", "type": "boolean", "summary": "Whether all qualifiers have been satisfied" }
          ]
        },
        {
          "name": "Timing",
          "fields": [
            { "name": "Duration Default", "type": "number", "summary": "Theoretical duration in minutes" },
            { "name": "Duration Baseline", "type": "number", "summary": "Historical average duration" },
            { "name": "Duration Actual", "type": "number", "summary": "Measured actual duration in minutes" },
            { "name": "Occurred At", "type": "date", "summary": "When the activity occurred" }
          ]
        },
        {
          "name": "Relationships",
          "fields": [
            { "name": "Activity Def", "type": "ref", "ref_target": "activity_def", "summary": "Reference to the activity definition" },
            { "name": "Actor", "type": "ref", "ref_target": "contact", "summary": "Who performed the action" },
            { "name": "Object", "type": "ref", "summary": "The entity being acted upon" },
            { "name": "Object Type", "type": "text", "summary": "Type of the object (asset, page, contact, etc.)" },
            { "name": "Related Opportunity", "type": "ref", "ref_target": "opportunity", "summary": "Associated opportunity for pipeline tracking" }
          ]
        }
      ]
    }
  },
