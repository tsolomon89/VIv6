  {
    "type": "object_def",
    "slug": "view",
    "name": "View",
    "summary": "A query definition that returns a set of records.",
    "data": {
      "category": "system",
      "icon": "eye",
      "is_system": true,
      "fieldGroups": [
        {
          "name": "Configuration",
          "fields": [
            { "name": "Source Type", "type": "select", "options": ["record", "relationship", "aggregate"], "required": true, "summary": "What the view queries" },
            { "name": "Target Entity Type", "type": "text", "summary": "Entity type to query (e.g., contact, opportunity)" },
            { "name": "Limit", "type": "number", "summary": "Maximum records to return" }
          ]
        },
        {
          "name": "Query",
          "fields": [
            { "name": "Filters", "type": "textarea", "summary": "JSON filter conditions: [{field, op, value}]" },
            { "name": "Sort", "type": "textarea", "summary": "JSON sort spec: [{field, direction}]" },
            { "name": "Context Params", "type": "textarea", "summary": "JSON list of typed input parameters: [{name, type, required}]" },
            { "name": "Output Schema", "type": "textarea", "summary": "JSON output field definitions for UI binding" }
          ]
        }
      ]
    }
  },
  {
    "type": "object_def",
    "slug": "derivation",
    "name": "Derivation",
