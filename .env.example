# VIv5 Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Security Keys
# =============================================================================
# Generate secure keys with: openssl rand -hex 32

# Admin API key for bypassing auth (use strong random value in production)
ADMIN_KEY=your-secure-admin-key-here

# JWT signing secret (minimum 32 characters recommended)
JWT_SECRET=your-jwt-secret-here-minimum-32-chars

# Encryption key for AI credentials (falls back to JWT_SECRET if not set)
AI_ENCRYPTION_KEY=your-ai-encryption-key-here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API server port
API_PORT=3001

# Environment (development | production)
NODE_ENV=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directory for file uploads (optional, defaults to ./uploads)
# UPLOADS_DIR=/path/to/uploads

# =============================================================================
# OPTIONAL - Background Services
# =============================================================================

# Auto-start AI activity scheduler on server boot
AI_SCHEDULER_AUTO_START=false
AI_SCHEDULER_INTERVAL=30000

# Auto-start workflow scheduler on server boot
WORKFLOW_SCHEDULER_AUTO_START=false
WORKFLOW_SCHEDULER_INTERVAL=60000

# Auto-start health decay daemon on server boot
HEALTH_DAEMON_AUTO_START=false
HEALTH_DAEMON_INTERVAL=300000
