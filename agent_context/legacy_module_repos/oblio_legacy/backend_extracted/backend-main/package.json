{
  "name": "oblio-back",
  "version": "1.0.0",
  "description": "Oblio's Backend, written with love using Fastify and TypeScript",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "clear && tsc -p tsconfig.json && NODE_ENV=dev node build/index.js",
    "prod": "tsc -p tsconfig.json && NODE_ENV=prod node build/index.js",
    "start": "PORT=3040 HOST=0.0.0.0 node build/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
