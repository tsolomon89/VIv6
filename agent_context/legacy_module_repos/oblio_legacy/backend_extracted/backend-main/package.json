  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^7.0.0",
    "@fastify/secure-session": "^4.1.1",
    "@types/jsforce": "^1.9.42",
    "dotenv": "^16.0.1",
    "fastify": "^3.29.0",
    "firebase-admin": "^10.2.0",
    "jsforce": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^17.0.35",
    "typescript": "^4.7.2"
  }
}