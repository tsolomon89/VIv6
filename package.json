    "dev:api": "tsx watch src/api/server.ts",
    "dev:ui": "cd src/ui && npm run dev",
    "start:api": "tsx src/api/server.ts",
    "mcp:start": "tsx src/mcp/server.ts",
    "build": "tsx src/build/generate.ts",
    "build:brand": "tsx src/build/generate.ts --brand",
    "zip": "bestzip site.zip dist/*",
    "seed": "tsx src/scripts/seed_from_data.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:status": "tsx src/scripts/migrate.ts status"
  },
