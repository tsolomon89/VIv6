<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.title}} | {{brand.name}}</title>
  <meta name="description" content="{{meta.description}}">
  
  <!-- CSS Reset & Variables -->
  <style>
    :root {
      --color-bg: #0f0f11;
      --color-text: #e4e4e7;
      --color-primary: #6366f1;
      --font-body: system-ui, -apple-system, sans-serif;
    }
    body {
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      margin: 0;
      line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }
    * { box-sizing: border-box; }
    
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-primary);
      color: white;
      border-radius: 999px;
      font-weight: 500;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.9; }
  </style>
</head>
<body>
  
  <header style="border-bottom: 1px solid #27272a; padding: 1.5rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; items-align: center;">
      <a href="/" style="font-weight: 700; font-size: 1.25rem;">{{brand.name}}</a>
      <nav>
        <!-- Nav items could be dynamic based on Entity Type 'page' -->
      </nav>
    </div>
  </header>

  <main>
    {{{body}}}
  </main>

  <footer style="border-top: 1px solid #27272a; padding: 3rem 0; margin-top: 5rem; color: #71717a;">
    <div class="container">
      &copy; {{year}} {{brand.name}}. Generated by Victory Initiative.
    </div>
  </footer>

</body>
</html>
